{
	"name": "url-simple",
	"version": "1.0.0",
	"description": "Automatically cleans trackers, shortens known urls, and fetches titles on paste",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"url",
		"cleaner"
	],
	"author": "JButler",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^16.11.6",
		"@typescript-eslint/eslint-plugin": "^8.49.0",
		"@typescript-eslint/parser": "^8.49.0",
		"builtin-modules": "3.3.0",
		"esbuild": "^0.27.1",
		"eslint": "^8.57.1",
		"eslint-plugin-obsidianmd": "^0.1.9",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "^5.9.3"
	}
}
